# Copy to VisualEyes/.env and fill in what you use. VisualEyes/.env is in .gitignore — never commit keys.

# AI sentence suggestions (Claude)
ANTHROPIC_API_KEY=
# GAZETYPE_FAST_MODEL=claude-haiku-5-5
# GAZETYPE_MODEL=claude-opus-5-5

# Voice: speak in the user's cloned voice (ElevenLabs). Leave empty for the system voice.
# The key starts with sk_ and needs Text to Speech access.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is fastest; eleven_multilingual_v2 sounds slightly better
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Accounts and preferences: save to the real DynamoDB table instead of memory (needs AWS credentials on this machine).
# VOICE_STORE=dynamodb
# VOICE_TABLE_NAME=vocaleyes-voices
# AWS_REGION=us-east-1

# Sign-in with Auth0 (none of these are secrets). Auth0 dashboard:
#   Applications > Create > Single Page Application  -> Domain and Client ID below.
#     Allowed Callback, Logout and Web Origins URLs: http://localhost:5173 (and the deployed site's address)
#   Applications > APIs > Create API, any Identifier (e.g. https://api.vocaleyes)  -> Audience below.
#     Turn on "Allow Offline Access" so people stay signed in.
# The voice service reads these too, to check that sign-in tokens are real.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
