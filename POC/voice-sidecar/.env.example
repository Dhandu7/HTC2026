# Copy this to `.env` (same folder) and paste your ElevenLabs API key after the equals sign.
#   cp .env.example .env
# `.env` is ignored by git, so it will not be committed. Never paste the key into chat or into this example file.
#
# Only ELEVENLABS_API_KEY is read from this file (by ./hosted.sh serve, smoke, doctor, reconcile, config).
# No quotes needed, no spaces around the equals sign.
ELEVENLABS_API_KEY=
